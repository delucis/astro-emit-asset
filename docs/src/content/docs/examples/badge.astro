---
import { emitAsset } from 'astro-emit-asset/emit';
import sharp from 'sharp';

export const badge = await emitAsset('badge.gif', [], async () => ({
	data: await sharp({
		create: {
			width: 88,
			height: 31,
			channels: 3,
			background: { r: 20, g: 20, b: 80 },
			noise: { type: 'gaussian', mean: 20, sigma: 40 },
		},
	})
		.composite([
			{
				input: {
					create: { width: 88, height: 2, channels: 3, background: { r: 60, g: 60, b: 120 } },
				},
				gravity: 'south',
			},
			{
				input: {
					create: { width: 2, height: 31, channels: 3, background: { r: 60, g: 60, b: 120 } },
				},
				gravity: 'east',
			},
			{
				input: {
					create: { width: 88, height: 2, channels: 3, background: { r: 120, g: 120, b: 220 } },
				},
				gravity: 'north',
			},
			{
				input: {
					create: { width: 2, height: 31, channels: 3, background: { r: 120, g: 120, b: 220 } },
				},
				gravity: 'west',
			},
			{
				input: {
					text: {
						text: '🖼️   <span foreground="white" weight="bold">my.gif</span>',
						width: 88 - 14,
						height: 31 - 14,
						rgba: true,
					},
				},
			},
		])
		.gif()
		.toBuffer(),
}));
---

<img
	src={badge.src}
	alt="Generated 88x31 pixel badge with the text 'my.gif' and a framed picture emoji"
	style={{ marginInline: 'auto', imageRendering: 'pixelated' }}
	width="88"
	height="31"
/>
