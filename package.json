{
  "name": "astro-emit-asset-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
  "repository": {
    "type": "git",
    "url": "https://github.com/delucis/astro-emit-asset.git"
  },
  "bugs": "https://github.com/delucis/astro-emit-asset/issues",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  },
  "scripts": {
    "%docs": "pnpm --filter ./docs",
    "%core": "pnpm --filter astro-emit-asset",
