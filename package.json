  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
