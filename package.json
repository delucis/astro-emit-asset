  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
