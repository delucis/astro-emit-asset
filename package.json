  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
