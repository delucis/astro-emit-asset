{
  "name": "astro-emit-asset-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
  "repository": {
    "type": "git",
    "url": "https://github.com/delucis/astro-emit-asset.git"
  },
  "bugs": "https://github.com/delucis/astro-emit-asset/issues",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  },
  "scripts": {
    "%docs": "pnpm --filter ./docs",
    "%core": "pnpm --filter astro-emit-asset",
    "build": "pnpm -r build",
    "predev": "pnpm %core build",
