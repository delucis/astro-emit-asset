{
  "name": "astro-emit-asset-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Emit static assets from Astro components and endpoints",
  "author": "delucis",
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "private": true,
  "homepage": "https://github.com/delucis/astro-emit-asset",
  "repository": {
    "type": "git",
    "url": "https://github.com/delucis/astro-emit-asset.git"
  },
  "bugs": "https://github.com/delucis/astro-emit-asset/issues",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  },
  "scripts": {
    "%docs": "pnpm --filter ./docs",
    "%core": "pnpm --filter astro-emit-asset",
